{
  "name": "@fydellys/inertia-static",
  "private": true,
  "version": "0.3.3",
  "description": "Client of fydellys/inertia-static (ships inside the Composer package, js/dist). Development only.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fydellys/inertia-static.git"
  },
  "keywords": [
    "inertia",
    "inertiajs",
    "laravel",
    "ssg",
    "isr",
    "cdn",
    "vue",
    "react"
  ],
  "files": [
    "js/dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./js/dist/index.d.ts",
      "import": "./js/dist/index.js"
    },
    "./vue": {
      "types": "./js/dist/vue.d.ts",
      "import": "./js/dist/vue.js"
    },
    "./react": {
      "types": "./js/dist/react.d.ts",
      "import": "./js/dist/react.js"
    },
    "./inertia2": {
      "types": "./js/dist/inertia2/index.d.ts",
      "import": "./js/dist/inertia2/index.js"
    },
    "./inertia2/react": {
      "types": "./js/dist/inertia2/react.d.ts",
      "import": "./js/dist/inertia2/react.js"
    },
    "./vite": {
      "types": "./js/vite.d.ts",
      "import": "./js/vite.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint js"
  },
  "peerDependencies": {
    "@inertiajs/core": "^2.3.0 || ^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/core-v2": "npm:@inertiajs/core@^2.3.29",
    "@inertiajs/vue3": "^3.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue/test-utils": "^2.4.6",
    "axios": "^1.20.0",
    "eslint": "^10.12.0",
    "happy-dom": "^20.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0"
  }
}
