{
    "name": "fydellys/inertia-static",
    "description": "SSG + ISR for Laravel + Inertia, CDN-agnostic.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "fydellys",
            "homepage": "https://github.com/fydellys"
        }
    ],
    "homepage": "https://fydellys.github.io/inertia-static/",
    "support": {
        "issues": "https://github.com/fydellys/inertia-static/issues",
        "source": "https://github.com/fydellys/inertia-static",
        "docs": "https://fydellys.github.io/inertia-static/"
    },
    "keywords": [
        "laravel",
        "inertia",
        "inertiajs",
        "ssg",
        "isr",
        "cdn",
        "cache",
        "static",
        "ssr",
        "vue",
        "react",
        "cloudflare"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0.16|^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Fydellys\\InertiaStatic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fydellys\\InertiaStatic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fydellys\\InertiaStatic\\InertiaStaticServiceProvider"
            ],
            "aliases": {
                "StaticCache": "Fydellys\\InertiaStatic\\Facades\\StaticCache"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/node_modules",
            "/vendor",
            "/examples",
            "/docs",
            "/tests",
            "/js/src",
            "/js/tests",
            "/docker",
            "/.github",
            "/bin-php",
            "/bin-node",
            "/.phpunit.cache",
            "/package.json",
            "/package-lock.json",
            "/tsconfig.json",
            "/tsup.config.ts",
            "/vitest.config.ts",
            "/eslint.config.js",
            "/phpunit.xml",
            "/phpstan.neon",
            "/pint.json",
            "/.archive-check",
            "/.claude",
            "/composer.lock",
            "/project"
        ]
    }
}
